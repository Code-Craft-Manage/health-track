# Local development template. Copy to .env and fill in.
# In PRODUCTION these values come from GitHub Actions secrets (see
# .github/workflows/deploy.yml) — do NOT commit a real .env file.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-botfather

# Who may use the bot AND which spreadsheet tab each person logs to, as a JSON
# object of Telegram-ID -> tab name. The keys double as the authorized-user
# allowlist. Get an ID from @userinfobot. Must be single-line, quoted keys:
USER_TABS={"000000000": "Alice", "111111111": "Bob"}

# --- Google Sheets ---
# Spreadsheet ID is the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Base64 of token.json. For LOCAL dev you can leave this empty and instead keep
# a token.json file in the project root (created by generate_token.py).
GOOGLE_OAUTH_TOKEN_B64=

# --- Misc ---
TZ=America/Sao_Paulo
